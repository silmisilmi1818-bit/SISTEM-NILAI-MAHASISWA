if __name__ == "__main__":
    nama_matkul = input("Masukkan Nama Mata Kuliah: ")
    sistem = SistemNilai(nama_matkul)

    while True:
        print("\n--- MENU SISTEM NILAI ---")
        print("1. Tambah Data Mahasiswa")
        print("2. Ubah Nilai Mahasiswa (Tes Setter)")
        print("3. Tampilkan Laporan Nilai")
        print("4. Keluar")
        
        pilihan = input("Pilih menu (1-4): ")

        if pilihan == "1":
            nim = input("Masukkan NIM   : ")
            nama = input("Masukkan Nama  : ")
            try:
                nilai = float(input("Masukkan Nilai : "))
                mhs_baru = Mahasiswa(nim, nama, nilai)
                sistem.tambah_mahasiswa(mhs_baru)
                print("Data berhasil ditambahkan!")
            except ValueError:
                print("Error: Nilai harus berupa angka!")

        elif pilihan == "2":
            nim_edit = input("Masukkan NIM yang ingin diubah nilainya: ")
            try:
                nilai_revisi = float(input("Masukkan Nilai Baru: "))
                sistem.ubah_nilai_mahasiswa(nim_edit, nilai_revisi)
            except ValueError:
                print("Error: Nilai harus berupa angka!")

        elif pilihan == "3":
            sistem.tampilkan_laporan()

        elif pilihan == "4":
            print("Program selesai. Terima kasih!")
            break
        else:
            print("Pilihan tidak valid, silakan coba lagi.")